# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Django -----------------------------------------------------------------
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set to 1 only when serving over HTTPS (secure cookies + HSTS)
DJANGO_HTTPS=0

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
POSTGRES_DB=tether
POSTGRES_USER=killian
POSTGRES_PASSWORD=change-me-too

# --- pgAdmin 4 -----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-three
PGADMIN_PORT=5050

# --- Web -----------------------------------------------------------------------
HTTP_PORT=8080

# --- First-run bootstrap (used by web/entrypoint.sh) ---------------------------
# Creates this account if it does not exist. Use these as the test credentials
# when presenting. Leave DEMO_PASSWORD empty to skip creating the demo user.
DEMO_USERNAME=killian
DEMO_PASSWORD=change-me-demo
# 1 = load demo scenarios and baseline runs when the database is empty
SEED_DEMO=1
